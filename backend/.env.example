# MongoDB connection string (optional - will use local if not set)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/moodbite

# Port (automatically set by Render)
PORT=8000

# Spotify Web API Credentials (Optional - for music recommendations)
# Get these from https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here
